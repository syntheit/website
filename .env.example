# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# ── Admin auth (Auth.js v5 + GitHub OAuth) ──────────────────────────────
# Random secret used to sign session JWTs. Generate with:
#   openssl rand -base64 33
AUTH_SECRET=

# GitHub OAuth app credentials. Create one at:
#   https://github.com/settings/developers
# Authorization callback URL must include:
#   http://localhost:6288/api/auth/callback/github   (for dev)
#   https://matv.io/api/auth/callback/github         (for prod)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated allowlist of GitHub usernames permitted to use /admin.
# Anyone else who completes OAuth will be rejected and no session is created.
ADMIN_GITHUB_USERS=syntheit

# ── Pexels (photography portfolio) ─────────────────────────────────────
# API key from https://www.pexels.com/api/. Used to fetch the photo gallery.
PEXELS_API_KEY=

# ID of the Pexels Collection that backs /photography. Create a collection on
# pexels.com containing your best work and grab the ID from the URL when you
# open it. The site fetches that collection at build time and revalidates
# hourly — adding/removing photos there auto-updates the gallery. Without
# this, /photography falls back to the snapshot at public/data/photos.json.
PEXELS_COLLECTION_ID=

# ── Admin data storage ──────────────────────────────────────────────────
# Directory where the admin panel persists its edits (overrides.json,
# list-overrides.json, custom-lists.json). Defaults to public/data/world
# relative to the working directory, which is fine for dev but ephemeral in
# a standalone deploy — point this at a persistent path (mounted volume)
# in production so admin edits survive redeploys.
# WORLD_DATA_DIR=
